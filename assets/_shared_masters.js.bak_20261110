];
var MB_KEY = 'tliMaterialBooks_v1';
function loadMaterialBooks(){
  try {
    var a = JSON.parse(global.localStorage.getItem(MB_KEY) || 'null');
    if (Array.isArray(a) && a.length){ materialBooks.length = 0; a.forEach(function(x){ materialBooks.push(x); }); }
