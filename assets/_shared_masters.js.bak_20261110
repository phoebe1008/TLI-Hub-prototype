 {id:'fr', name:'法文', nameMulti:'French／Français', enabled:true, legacyNames:['法語']},
 {id:'tw', name:'台語', nameMulti:'Taiwanese／臺語', enabled:true},
 {id:'wu', name:'上海話', nameMulti:'Shanghainese／上海話', enabled:true},
