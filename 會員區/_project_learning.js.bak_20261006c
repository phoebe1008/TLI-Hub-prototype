  function fmtLocal(utcMs, off) { var d = new Date(utcMs + off * 3600000); return { date: ymd(d), time: pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()), hm: d.getUTCHours() * 60 + d.getUTCMinutes() }; }
  function sessionsFor(user) {
